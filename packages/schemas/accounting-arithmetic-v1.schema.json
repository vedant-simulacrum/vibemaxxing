{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibemaxxing.dev/schemas/accounting-arithmetic-v1.json",
  "title": "AccountingArithmetic v1",
  "description": "The arithmetic every accounting profile is evaluated under. An accounting profile states which source fields exist and how they contain one another; this record states what is summed, in what order, at what width, with what rounding, and what happens on overflow. The two together are what two independent implementations need in order to agree on a token total. D-193 forbids floats, so every quantity here is an integer with a stated scale.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "arithmetic_id",
    "semantic_version",
    "content_sha256",
    "digest",
    "integer_domain",
    "canonical_component_order",
    "containment_resolution",
    "token_burn",
    "estimated_cash_burn",
    "execution_semantics",
    "outcome_normalization",
    "bounds",
    "reconciliation",
    "correction_semantics"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "arithmetic_id": {
      "$ref": "#/$defs/registered_id"
    },
    "semantic_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "content_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "digest": {
      "description": "The canonical digest rule. `accounting_profile_sha256` is a signed claim field, so the preimage cannot be left to an implementation's JSON serializer. The preimage is the same deterministic CBOR the signed claim uses, restricted to integers, text strings, arrays, maps and the simple value `null`. Floats are refused because RFC 8949 Section 4.2.2 leaves their determinism to the protocol and D-193 declines to define one; booleans are refused because a two-valued field written as a named enum stays legible inside the preimage. `null` is permitted because an absent value needs a representation and has exactly one deterministic encoding.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "preimage_encoding",
        "map_ordering",
        "key_encoding",
        "excluded_fields",
        "forbidden_preimage_types",
        "applies_to"
      ],
      "properties": {
        "algorithm": {
          "const": "sha-256"
        },
        "preimage_encoding": {
          "const": "cbor-core-deterministic"
        },
        "map_ordering": {
          "const": "rfc8949-4.2.1-bytewise"
        },
        "key_encoding": {
          "const": "text-string"
        },
        "excluded_fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "const": "content_sha256"
          }
        },
        "forbidden_preimage_types": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 3,
          "items": {
            "enum": [
              "float",
              "boolean",
              "null",
              "tag",
              "indefinite-length"
            ]
          }
        },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/registered_id"
          }
        }
      }
    },
    "integer_domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representation",
        "wire_width",
        "minimum",
        "maximum",
        "addition",
        "subtraction",
        "overflow_disposition",
        "underflow_disposition"
      ],
      "properties": {
        "representation": {
          "const": "decimal-string"
        },
        "wire_width": {
          "const": "uint64"
        },
        "minimum": {
          "const": "0"
        },
        "maximum": {
          "const": "18446744073709551615"
        },
        "addition": {
          "const": "checked"
        },
        "subtraction": {
          "const": "checked"
        },
        "overflow_disposition": {
          "description": "A sum that leaves the domain is a defect, not a number. Saturating would silently cap a total and wrapping would silently invert one.",
          "const": "reject"
        },
        "underflow_disposition": {
          "const": "reject"
        }
      }
    },
    "canonical_component_order": {
      "description": "The summation order. Addition over a bounded checked domain is not associative with respect to failure: a different order can overflow at a different step. Fixing the order fixes which vector fails and where.",
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/canonical_component"
      }
    },
    "containment_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "traversal",
        "operation",
        "cycle_disposition",
        "multiple_container_disposition",
        "underflow_disposition",
        "unknown_category_encoding",
        "unmapped_source_field_disposition"
      ],
      "properties": {
        "traversal": {
          "const": "container-before-member-topological"
        },
        "operation": {
          "const": "checked-subtract"
        },
        "cycle_disposition": {
          "const": "reject"
        },
        "multiple_container_disposition": {
          "description": "A source field contained by two containers cannot be subtracted once without choosing a container, and choosing one is a hidden semantic mapping.",
          "const": "reject"
        },
        "underflow_disposition": {
          "description": "A member larger than its container is the contradiction case: the source reported a containment its own numbers deny.",
          "const": "reject"
        },
        "unknown_category_encoding": {
          "const": "absent-never-zero"
        },
        "unmapped_source_field_disposition": {
          "const": "reject"
        }
      }
    },
    "token_burn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition",
        "scale",
        "unit",
        "summation_order",
        "disabled_component_value",
        "disabled_component_meaning"
      ],
      "properties": {
        "definition": {
          "const": "checked-sum-of-enabled-canonical-components"
        },
        "scale": {
          "const": 0
        },
        "unit": {
          "const": "tokens"
        },
        "summation_order": {
          "const": "canonical-component-order"
        },
        "disabled_component_value": {
          "const": "0"
        },
        "disabled_component_meaning": {
          "description": "A component the profile does not enable is written as zero and read as `the profile declares this unavailable`. It is never read as `the source reported nothing`.",
          "const": "profile-declared-unavailable"
        }
      }
    },
    "estimated_cash_burn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scale",
        "unit",
        "unit_price_scale",
        "unit_price_unit",
        "product",
        "reduction",
        "divisor",
        "rounding",
        "rounding_sites",
        "unpriced_disposition",
        "label"
      ],
      "properties": {
        "scale": {
          "const": 6
        },
        "unit": {
          "const": "pricing-currency-micro-units"
        },
        "unit_price_scale": {
          "const": 9
        },
        "unit_price_unit": {
          "const": "pricing-currency-nano-units-per-token"
        },
        "product": {
          "description": "Integer units multiplied by an integer nano-unit price is an exact integer. No intermediate value is ever inexact.",
          "const": "exact-integer"
        },
        "reduction": {
          "const": "sum-of-exact-products-then-single-divide"
        },
        "divisor": {
          "description": "Nano-units per micro-unit. Units multiplied by a nano-unit price give a nano-unit sum; dividing by 1000 once yields the micro-unit estimate.",
          "const": "1000"
        },
        "rounding": {
          "const": "round-half-even"
        },
        "rounding_sites": {
          "description": "Rounding once, at the end, is what makes the estimate reproducible. Rounding per category makes the total depend on how the categories were grouped.",
          "const": 1
        },
        "unpriced_disposition": {
          "const": "unpriced-never-zero"
        },
        "label": {
          "const": "estimated"
        }
      }
    },
    "execution_semantics": {
      "description": "The behaviour behind the three policy enums in `accounting-profile.schema.json`. Those enums were labels; these are the rules an implementation follows when it reads one.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retry",
        "cancellation",
        "nested_execution"
      ],
      "properties": {
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "each-model-execution",
            "caller-visible-only",
            "provider-total-authoritative"
          ],
          "properties": {
            "each-model-execution": {
              "$ref": "#/$defs/retry_rule"
            },
            "caller-visible-only": {
              "$ref": "#/$defs/retry_rule"
            },
            "provider-total-authoritative": {
              "$ref": "#/$defs/retry_rule"
            }
          }
        },
        "cancellation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count-reported-consumption",
            "count-terminal-total",
            "quarantine-unknown"
          ],
          "properties": {
            "count-reported-consumption": {
              "$ref": "#/$defs/cancellation_rule"
            },
            "count-terminal-total": {
              "$ref": "#/$defs/cancellation_rule"
            },
            "quarantine-unknown": {
              "$ref": "#/$defs/cancellation_rule"
            }
          }
        },
        "nested_execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "children-exclusive",
            "parent-total-contains-children",
            "independent-with-dedup-domain"
          ],
          "properties": {
            "children-exclusive": {
              "$ref": "#/$defs/nested_rule"
            },
            "parent-total-contains-children": {
              "$ref": "#/$defs/nested_rule"
            },
            "independent-with-dedup-domain": {
              "$ref": "#/$defs/nested_rule"
            }
          }
        }
      }
    },
    "outcome_normalization": {
      "description": "The map from what a source observation reported to what the normalized event records. The two vocabularies shared three of five values and each held two the other did not; with no map declared, `aborted-unknown` had to be written as `aborted-known`, which inverts the fact the source reported, and `unknown` had to be written as `quarantined-unknown`, which is a decision rather than an observation. scripts/repository/validate_planning_artifacts.py checks the map against both schemas: `observed` must equal the observation enum exactly, `normalized` must be admitted by the event enum, and every event value the map does not reach must appear in `normalizer_assigned` with a reason, so neither a missing case nor an excuse for a case that no longer exists survives.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "codomain",
        "map",
        "normalizer_assigned"
      ],
      "properties": {
        "domain": {
          "const": "source-observation-v1.outcome"
        },
        "codomain": {
          "const": "normalized-accounting-event-v1.outcome"
        },
        "map": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observed",
              "normalized"
            ],
            "properties": {
              "observed": {
                "$ref": "#/$defs/outcome_value"
              },
              "normalized": {
                "$ref": "#/$defs/outcome_value"
              }
            }
          }
        },
        "normalizer_assigned": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "normalized",
              "reason"
            ],
            "properties": {
              "normalized": {
                "$ref": "#/$defs/outcome_value"
              },
              "reason": {
                "type": "string",
                "minLength": 40,
                "maxLength": 600
              }
            }
          }
        }
      }
    },
    "bounds": {
      "description": "The practical ceilings, distinct from the integer domain above. The domain says what a uint64 can hold; these say what one operation and one period can plausibly hold, and that a value outside either is refused rather than reported as the ceiling. Neither is a cap on what a participant may accumulate: Token Burn is accepted, immutable and unnormalized, and a bound that clipped an accumulated total would normalize the metric of record under another name.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "per_event_token_burn_maximum",
        "per_event_exceeded_disposition",
        "per_event_basis",
        "period_type",
        "period_accumulator_width",
        "period_accumulator_maximum",
        "period_exceeded_disposition",
        "period_basis",
        "saturation",
        "capping",
        "capping_reason",
        "rejected_event_effect"
      ],
      "properties": {
        "per_event_token_burn_maximum": {
          "$ref": "#/$defs/uint64_decimal"
        },
        "per_event_exceeded_disposition": {
          "const": "reject"
        },
        "per_event_basis": {
          "type": "string",
          "minLength": 40,
          "maxLength": 800
        },
        "period_type": {
          "enum": [
            "utc-day",
            "iso-week",
            "utc-month",
            "utc-year"
          ]
        },
        "period_accumulator_width": {
          "const": "uint64"
        },
        "period_accumulator_maximum": {
          "$ref": "#/$defs/uint64_decimal"
        },
        "period_exceeded_disposition": {
          "const": "reject"
        },
        "period_basis": {
          "type": "string",
          "minLength": 40,
          "maxLength": 800
        },
        "saturation": {
          "const": "forbidden"
        },
        "capping": {
          "const": "forbidden"
        },
        "capping_reason": {
          "type": "string",
          "minLength": 40,
          "maxLength": 800
        },
        "rejected_event_effect": {
          "const": "single-event-rejected-period-total-unchanged"
        }
      }
    },
    "reconciliation": {
      "description": "How several readings of one operation become one accounted figure. The accounting profile already said which fields exist and which authority each carries; nothing said what happens when two of them describe the same operation, so the answer was whichever reading an implementation processed last. Every rule here is stated so that the result is a function of the readings and never of their order.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grouping",
        "group_key",
        "absent_identity_disposition",
        "cumulative_reading_disposition",
        "cumulative_reading_reason",
        "authority_vocabulary",
        "authority_order",
        "authority_order_basis",
        "lower_authority_disposition",
        "summation_across_readings",
        "equal_authority_agreement",
        "equal_authority_contradiction",
        "contradiction_test",
        "contradiction_resolution_by_selection",
        "contradiction_reason",
        "ordering_independence",
        "tie_break_order",
        "forbidden_tie_break_inputs",
        "mode_precedence_authority"
      ],
      "properties": {
        "grouping": {
          "const": "one-operation-within-one-exclusivity-unit"
        },
        "group_key": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$",
            "maxLength": 64
          }
        },
        "absent_identity_disposition": {
          "const": "private-analytics"
        },
        "cumulative_reading_disposition": {
          "const": "reject"
        },
        "cumulative_reading_reason": {
          "type": "string",
          "minLength": 40,
          "maxLength": 800
        },
        "authority_vocabulary": {
          "const": "normalized-accounting-event-v1.count_authority"
        },
        "authority_order": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/registered_id"
          }
        },
        "authority_order_basis": {
          "type": "string",
          "minLength": 40,
          "maxLength": 900
        },
        "lower_authority_disposition": {
          "const": "superseded"
        },
        "summation_across_readings": {
          "description": "Two readings of one operation are two descriptions of one consumption, never two consumptions. Adding them is the double count the whole record exists to prevent.",
          "const": "forbidden"
        },
        "equal_authority_agreement": {
          "const": "one-counted-remainder-superseded"
        },
        "equal_authority_contradiction": {
          "const": "profile-contradiction-policy"
        },
        "contradiction_test": {
          "const": "canonical-components-differ"
        },
        "contradiction_resolution_by_selection": {
          "const": "forbidden"
        },
        "contradiction_reason": {
          "type": "string",
          "minLength": 40,
          "maxLength": 900
        },
        "ordering_independence": {
          "const": "required"
        },
        "tie_break_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/registered_id"
          }
        },
        "forbidden_tie_break_inputs": {
          "description": "Every one of these is a property of when or in what order a reading arrived rather than of what it says. A tie broken on any of them is a total that changes when the same facts are replayed in a different order.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/registered_id"
          }
        },
        "mode_precedence_authority": {
          "const": "observer-equivalence-v1.observation_modes"
        }
      }
    },
    "correction_semantics": {
      "description": "How a correction changes a previously accepted total. It does not: an accepted claim is immutable and a correction is a new contribution that a later generation composes.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_total_mutability",
        "mechanism",
        "directions",
        "magnitude_representation",
        "negative_encoding",
        "composition",
        "period_effect",
        "pricing_effect",
        "reversal",
        "floor"
      ],
      "properties": {
        "accepted_total_mutability": {
          "const": "immutable"
        },
        "mechanism": {
          "const": "append-only-contribution"
        },
        "directions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "add",
              "retract"
            ]
          }
        },
        "magnitude_representation": {
          "description": "The domain is unsigned, so a retraction carries a direction and an unsigned magnitude rather than a negative integer.",
          "const": "unsigned-magnitude-with-direction"
        },
        "negative_encoding": {
          "const": "forbidden"
        },
        "composition": {
          "const": "checked-sum-of-additions-minus-checked-sum-of-retractions"
        },
        "period_effect": {
          "const": "rebuild-generation-and-supersede"
        },
        "pricing_effect": {
          "const": "new-interpretation-record"
        },
        "reversal": {
          "const": "append-only"
        },
        "floor": {
          "description": "Retractions summing past the additions they correct is an accounting defect and rejects rather than clamping to zero, because clamping hides the arithmetic that produced it.",
          "const": "reject-below-zero"
        }
      }
    }
  },
  "$defs": {
    "registered_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "uint64_decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "outcome_value": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "canonical_component": {
      "enum": [
        "input_uncached",
        "output_visible",
        "cache_read",
        "cache_write",
        "reasoning",
        "multimodal_input",
        "multimodal_output"
      ]
    },
    "retry_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counted_attempts",
        "requires_distinct_execution",
        "attempt_identity",
        "double_count_control"
      ],
      "properties": {
        "counted_attempts": {
          "enum": [
            "every-attempt-that-consumed",
            "caller-observed-attempts-only",
            "terminal-attempt-only"
          ]
        },
        "requires_distinct_execution": {
          "enum": [
            "yes",
            "no"
          ]
        },
        "attempt_identity": {
          "enum": [
            "retry-scope-and-ordinal",
            "source-total-only"
          ]
        },
        "double_count_control": {
          "enum": [
            "duplicate-domain",
            "source-total-authority"
          ]
        }
      }
    },
    "cancellation_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counted_quantity",
        "unknown_remainder",
        "disposition"
      ],
      "properties": {
        "counted_quantity": {
          "enum": [
            "reported-consumption",
            "terminal-total",
            "none"
          ]
        },
        "unknown_remainder": {
          "enum": [
            "absent-never-zero",
            "quarantine-event"
          ]
        },
        "disposition": {
          "enum": [
            "count",
            "quarantine"
          ]
        }
      }
    },
    "nested_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "child_attribution",
        "parent_total_treatment",
        "dedup_control"
      ],
      "properties": {
        "child_attribution": {
          "const": "initiating-account-and-device-lineage"
        },
        "parent_total_treatment": {
          "enum": [
            "children-counted-parent-excludes-them",
            "parent-total-authoritative-children-excluded",
            "each-observation-counted-once-under-equivalence"
          ]
        },
        "dedup_control": {
          "enum": [
            "parent-child-edge",
            "source-total-authority",
            "observer-equivalence"
          ]
        }
      }
    }
  }
}
