; VibeProof protocol v1 — normative planning CDDL for P-1140C.
; Maps are closed: integer labels not listed here are invalid.
; Deterministic encoding is RFC 8949 core deterministic encoding plus the
; stricter limits in docs/architecture/VIBEPROOF_V1_PROTOCOL.md.

uint64 = 0..18446744073709551615
uint32 = 0..4294967295
epoch-ms = 0..253402300799999
uuid7 = bytes .size 16
digest32 = bytes .size 32
nonce32 = bytes .size 32
signature64 = bytes .size 64
registered-id = uint32
reason-code = uint32

token-categories = {
  0: uint64, ; input_uncached
  1: uint64, ; output_visible
  2: uint64, ; cache_read
  3: uint64, ; cache_write
  4: uint64, ; reasoning
  5: uint64, ; multimodal_input
  6: uint64  ; multimodal_output
}

vibeproof-claim-v1 = {
  0: 1,                    ; protocol_major
  1: 0..65535,             ; protocol_minor
  2: uuid7,                ; claim_id
  3: digest32,             ; account_pseudonym
  4: uuid7,                ; device_lineage_id
  5: uuid7,                ; active_key_id
  6: uint64,               ; claim_sequence
  7: digest32,             ; previous_local_commitment_head
  8: digest32,             ; current_local_commitment_head
  9: uuid7 / nil,          ; previous_checkpoint_receipt_id
  10: uuid7,               ; challenge_id
  11: nonce32,             ; challenge_nonce
  12: epoch-ms,            ; event_interval_start_ms
  13: epoch-ms,            ; event_interval_end_ms
  14: uint64,              ; time_uncertainty_ms
  15: uint64,              ; monotonic_duration_ns
  16: digest32,            ; adapter_artifact_sha256
  17: digest32,            ; collector_artifact_sha256
  18: digest32,            ; certification_bundle_sha256
  19: registered-id,       ; source_id
  20: registered-id,       ; provider_id
  21: registered-id,       ; model_id
  22: registered-id,       ; accounting_profile_id
  23: digest32,            ; accounting_profile_sha256
  24: token-categories,
  25: digest32,            ; duplicate_domain_commitment
  26: registered-id,       ; deterministic_rule_bundle_id
  27: [* reason-code],     ; compact deterministic result codes
  28: registered-id,       ; privacy_policy_id
  29: true,                ; privacy_pass (false claims never serialize)
  30: digest32 / nil,      ; optional local detector result commitment
  ; ADR-007: "Every claim in the batch signs the same batch challenge nonce plus
  ; its own batch ID, zero-based index, total count, sequence, and previous-claim
  ; hash." Labels 6, 7 and 11 carried the sequence, the previous head and the
  ; nonce; the batch position was not signed by anything, so ADR-007's rejection
  ; of "missing indices, duplicate indices, changed order" could only be applied
  ; to the unsigned outer `batch-context`, which a submitter controls freely. The
  ; three labels below put the batch position inside the signed payload, which is
  ; what makes that rejection enforceable rather than asserted.
  31: uuid7,               ; batch_id, equal to batch-context label 1
  32: 0..255,              ; batch_index, zero-based position in batch-context label 4
  33: 1..256,              ; batch_claim_count, equal to the length of that array
  ; The digest of the COSE_Sign1 gap declaration this claim carries, or nil when
  ; the sequence is contiguous. ADR-007 requires the declaration to be "included
  ; in the first claim after the gap"; this map is closed and a COSE envelope is a
  ; tagged item, so the envelope travels in batch-context label 5 and the claim
  ; signs its digest. Signing the digest is what binds the declaration to the
  ; claim: an envelope swapped in transport no longer matches.
  34: digest32 / nil
}

; One appraisal record. The same aggregate is described by
; packages/schemas/appraisal-result-v1.schema.json, which is its normative shape, and
; persisted by `verifier_appraisals` in packages/schemas/planning-schema.sql. The three
; are bound field by field rather than in prose: packages/schemas/appraisal-policy-v1.json
; carries `appraisal_record.wire_binding`, which maps every label below to the record
; field it encodes and records, for each record field that is deliberately not on the
; wire, why it is not. `validate_evidence_chain` compares the three field sets in every
; direction, so a field added here and nowhere else fails, and so does a field added
; there and not here. Until PF-072 only the ten integer-range labels were parsed at all,
; which is why labels 3, 5, 14 and 18..22 could disagree with the record unnoticed.
;
; Nullability is a fact about the aggregate rather than a convenience. Label 5 admits nil
; because no verifier implementation is built, label 14 because a rejected or quarantined
; claim is awarded no profile, and label 18 because a capture bound to no certification is
; every capture this repository can currently take.
verifier-appraisal-v1 = {
  0: 1,
  1: uuid7,                ; appraisal_id
  2: uuid7,                ; claim_id
  3: digest32,             ; canonical_claim_sha256
  4: registered-id,        ; verifier_policy_id
  5: digest32 / nil,       ; verifier_implementation_sha256
  6: 0..7,                 ; acceptance_outcome
  7: 0..5,                 ; source_class
  8: 0..3,                 ; capture_class
  9: 0..3,                 ; accounting_class
  10: 0..5,                ; device_key_class
  11: 0..4,                ; continuity_class
  12: 0..4,                ; environment_class
  13: 0..3,                ; freshness_class
  14: registered-id / nil, ; awarded profile id
  15: 0..5,                ; ranking eligibility
  16: [* reason-code],     ; reason codes
  17: 0..4,                ; anomaly disposition
  18: digest32 / nil,      ; certification bundle sha256
  19: digest32,            ; policy content sha256
  20: epoch-ms,            ; effective from
  21: epoch-ms / nil,      ; effective until
  22: registered-id / nil, ; re evaluation trigger
  ; The four facts the record carried and no wire label did. An appraisal that cannot
  ; encode its own evidence bundle, its place in the supersession chain, or the lifecycle
  ; state of the certification it was appraised under is not the record the schema
  ; describes; it is a subset of it that happens to validate.
  23: digest32 / nil,      ; evidence bundle sha256
  24: uuid7 / nil,         ; supersedes appraisal id
  25: uuid7 / nil,         ; superseded by appraisal id
  26: 0..8,                ; certification state
  27: registered-id,       ; deterministic rule bundle id
  28: registered-id,       ; accounting profile id
  29: registered-id        ; observer equivalence rule id
}

; The canonical acknowledged head. `packages/schemas/planning-schema.sql#checkpoint_receipts`
; persists exactly labels 1..11 and `packages/schemas/openapi-v1.yaml#CheckpointReceipt`
; projects exactly labels 1..11 into JSON; label 0 is the protocol major and is stored in
; neither, because the DDL is versioned by migration and the API by path.
; `scripts/repository/validate_checkpoint_receipt_binding.py` holds the three-way table
; and fails on any divergence. Before PF-073 the three definitions were near-disjoint:
; the table shared one concept with this rule and stored it as `last_sequence`, and
; label 7 — `server_receipt_sequence`, which docs/architecture/VIBEPROOF_V1_PROTOCOL.md
; lists as server state — existed in this file alone, stored nowhere and read by
; nothing. The API had no receipt component at all and published the receipt as an
; opaque base64 blob, so eleven signed fields reached the client as bytes with no
; published meaning.
checkpoint-receipt-v1 = {
  0: 1,                    ; protocol_major
  1: uuid7,                ; receipt_id
  2: digest32,             ; account_pseudonym
  3: uuid7,                ; device_lineage_id
  4: uint64,               ; accepted_through_claim_sequence
  5: digest32,             ; accepted_local_commitment_head
  6: digest32,             ; last_accepted_claim_sha256
  7: uint64,               ; server_receipt_sequence
  8: registered-id,       ; verifier_policy_id
  9: epoch-ms,             ; issued_at
  10: epoch-ms,            ; expires_at
  11: uuid7                ; server_signing_key_id
}

; The canonical challenge. `packages/schemas/planning-schema.sql#claim_challenges`
; persists exactly these eleven fields and `packages/schemas/openapi-v1.yaml#ClaimChallenge`
; projects exactly these eleven fields into JSON; `scripts/repository/validate_batch_challenge_binding.py`
; holds the three-way table and fails on any divergence. Before that, the three
; definitions bound disjoint field sets: labels 5, 6 and 7 existed in no column and
; no API property, so the "expected tuple" verification that
; docs/architecture/VIBEPROOF_V1_PROTOCOL.md attributes to the server had nothing
; to read.
challenge-v1 = {
  0: 1,                    ; protocol_major
  1: uuid7,                ; challenge_id
  2: digest32,             ; account_pseudonym
  3: uuid7,                ; device_lineage_id
  4: nonce32,              ; nonce
  5: uint64,               ; expected_next_sequence
  6: digest32,             ; expected_local_commitment_head
  7: uuid7 / nil,          ; expected_checkpoint_receipt_id
  8: epoch-ms,             ; issued_at
  9: epoch-ms,             ; expires_at
  ; ADR-007 requires the challenge to carry "maximum claim count, and maximum
  ; encoded bytes". The count was `uint32`, which admits 4294967295 while
  ; batch-context label 4 admits 256, so a challenge could authorize a batch no
  ; batch could encode. The byte ceiling was absent entirely.
  10: 1..256,              ; max_batch_claims
  11: uint32               ; max_encoded_bytes
}

batch-context = {
  0: 1,
  1: uuid7,                ; batch_id
  2: digest32,             ; idempotency request fingerprint
  3: uuid7,                ; challenge_id
  4: [1*256 cose-sign1-claim-v1],
  ; One signed gap declaration per claim whose label 34 is non-nil, in the order
  ; those claims appear. The envelope cannot sit inside the claim itself: the claim
  ; map is closed and its payload is CBOR the canonical profile decodes, while a
  ; COSE_Sign1 is a tagged item the profile refuses. The claim signs the digest,
  ; so carrying the bytes out here does not make them unbound.
  5: [* cose-sign1-gap-v1]
}

; Partial acceptance is not encodable, rather than prohibited in prose only.
; ADR-007 states "Partial batch acceptance is prohibited in protocol v1" and
; VIBEPROOF_V1_PROTOCOL.md states "never partial success"; the previous single map
; gave every claim an independent outcome inside a batch with its own outcome and
; tied the two to nothing, so "batch committed, claims 3 and 7 rejected" was a
; valid instance. A committed batch now admits only accepted per-claim results and
; a refused batch admits only refused ones, so the mixed instance satisfies neither
; alternative. `conformance/vibeproof/v1/malformed-resource-corpus.json` carries the
; bytes of that mixed instance as a negative case, so the prohibition is exercised
; rather than declared.
atomic-batch-result-v1 = {
  0: 1,
  1: uuid7,                ; batch_id
  2: 0..1,                 ; committed / idempotent-replay
  3: digest32,             ; exact request fingerprint
  4: [1*256 claim-accepted-result-v1],
  5: [* cose-sign1-receipt-v1],
  6: bytes .size (0..1048576)
} / {
  0: 1,
  1: uuid7,                ; batch_id
  2: 2..5,                 ; conflict / rejected / quarantined / retryable
  3: digest32,             ; exact request fingerprint
  4: [1*256 claim-refused-result-v1],
  ; No checkpoint receipt is issued for a batch that did not commit. A receipt
  ; acknowledges an accepted head, and a refused batch advanced no head.
  5: [0*0 cose-sign1-receipt-v1],
  6: bytes .size (0..1048576)
}

; Ordinals are `wire_ordinals.acceptance_outcome` in
; packages/schemas/appraisal-policy-v1.json: 0 accepted, 1 accepted-with-downgrade,
; 2 accepted-private-analytics, 3 idempotent-replay, 4 quarantined, 5 rejected,
; 6 superseded, 7 retracted. The split is at 3/4: 0..3 admit the claim and carry an
; appraisal, 4..7 do not. A refusal carries at least one reason code, because a
; refusal with an empty reason list is the shape this repository has been bitten by
; nine times — a check satisfied by emptiness.
claim-accepted-result-v1 = { 0: uuid7, 1: 0..3, 2: [* reason-code], 3: uuid7 }
claim-refused-result-v1 = { 0: uuid7, 1: 4..7, 2: [1* reason-code], 3: nil }
claim-result-v1 = claim-accepted-result-v1 / claim-refused-result-v1

; ADR-007 identifies the declaration by "the first and last missing sequence"; this
; map binds the sequences either side of the gap. They are the same statement one
; apart — first missing is label 3 plus one, last missing is label 4 minus one — and
; the pair either side is the form that also states which heads the chain jumps
; between. The relation is recorded here rather than left for a reader to infer,
; because the two documents naming different fields for one quantity is what an
; implementer resolves by guessing.
;
; The 10,000-sequence maximum ADR-007 states is a relation between labels 3 and 4.
; CDDL constrains each label independently and has no control for the difference of
; two, so the bound is not expressible here and is not silently dropped: it is a
; CHECK constraint on `gap_declarations` in packages/schemas/planning-schema.sql and
; `continuity.max_recoverable_gap_sequences` in packages/schemas/policy-defaults-v1.json,
; and validate_batch_challenge_binding.py fails if either stops agreeing with the
; number ADR-007 states.
gap-declaration = {
  0: 1,
  1: uuid7,                ; gap_declaration_id
  2: uuid7,                ; device_lineage_id
  3: uint64,               ; sequence_before_gap
  4: uint64,               ; sequence_after_gap
  5: digest32,             ; local_commitment_head_before
  6: digest32,             ; local_commitment_head_after
  ; ADR-007 registers four causes: 0 local-corruption, 1 acknowledged-state-loss,
  ; 2 interrupted-migration, 3 key-recovery. The range was 0..5, so two ordinals
  ; were representable with no registered meaning and a declaration carrying one
  ; would have been accepted by the grammar and unresolvable by the verifier.
  7: 0..3,                 ; registered gap cause
  8: digest32,             ; local audit commitment
  9: epoch-ms              ; declared_at
}

key-rotation-transition-v1 = {
  0: 1,
  1: uuid7,
  2: uuid7,
  3: uuid7,                ; old key
  4: uuid7,                ; new key
  5: bytes .size 32,       ; new Ed25519 public key
  6: uint64,
  7: digest32,
  8: uuid7 / nil,
  9: epoch-ms,
  10: 0..3                 ; rotate / recover / retire / requalify
}
dual-authorized-rotation-v1 = [cose-sign1-rotation-v1, cose-sign1-rotation-v1]

correction-record-v1 = {
  0: 1,
  1: uuid7,
  2: uuid7,                ; affected claim
  3: uuid7,                ; affected appraisal
  4: registered-id,       ; correction policy
  5: 0..5,                 ; exclude / restore / replace appraisal / pricing-only / period-only / no-op
  6: [* reason-code],
  7: digest32,             ; authorizing action digest
  8: epoch-ms,
  9: uuid7 / nil           ; reverses correction
}

protected-headers-claim-v1 = {
  1: -19,                  ; alg = Ed25519 (RFC 9864; -8 EdDSA is deprecated)
  3: "application/vibemaxxing-claim+cbor",
  4: uuid7,                ; kid, raw UUID bytes
  1001: 1                  ; VibeProof protocol major
}
protected-headers-receipt-v1 = {
  1: -19,
  3: "application/vibemaxxing-receipt+cbor",
  4: uuid7,
  1001: 1
}
; D-043 and ADR-007 both say "signed gap-declaration". There were exactly three
; COSE wrappers — claim, receipt, rotation — and none of them was a gap, so the
; declaration was a bare CBOR map with no signed form, no protected-header rule and
; therefore no content type. Nothing could sign it, which made "signed" a word in
; two documents and a capability in none.
protected-headers-gap-v1 = {
  1: -19,
  3: "application/vibemaxxing-gap+cbor",
  4: uuid7,
  1001: 1
}

cose-sign1-claim-v1 = #6.18([
  protected: bytes,
  unprotected: {},
  payload: bytes,
  signature: signature64
])
cose-sign1-receipt-v1 = #6.18([
  protected: bytes,
  unprotected: {},
  payload: bytes,
  signature: signature64
])
cose-sign1-rotation-v1 = #6.18([
  protected: bytes,
  unprotected: {},
  payload: bytes,
  signature: signature64
])
cose-sign1-gap-v1 = #6.18([
  protected: bytes,
  unprotected: {},
  payload: bytes,
  signature: signature64
])
