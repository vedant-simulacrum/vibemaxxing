{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibemaxxing.dev/schemas/adapter-manifest-v1.json",
  "title": "VibeMaxxing Adapter Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_id",
    "semantic_version",
    "artifact_sha256",
    "manifest_payload_sha256",
    "provenance",
    "source_products",
    "source_version_range",
    "platforms",
    "modes",
    "capture_mechanism",
    "required_permissions",
    "observed_token_categories",
    "source_authority",
    "accounting_profile_ids",
    "certification",
    "capability_ceiling",
    "duplicate_domains",
    "lifecycle"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "adapter_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "semantic_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifest_payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit",
        "build_provenance_sha256",
        "sbom_sha256",
        "maintainer_kind",
        "maintainer_id"
      ],
      "properties": {
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "build_provenance_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sbom_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "maintainer_kind": {
          "enum": [
            "project",
            "community",
            "vendor"
          ]
        },
        "maintainer_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 128
        }
      }
    },
    "source_products": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
        "maxLength": 128
      }
    },
    "source_version_range": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "macos",
          "windows",
          "linux",
          "wsl",
          "container",
          "ci",
          "remote"
        ]
      }
    },
    "modes": {
      "description": "Exactly the nine observation modes observer-equivalence-v1.json declares, in its precedence order. This enum previously carried `import` and omitted `acp`, which made it a second spelling of the one mode vocabulary - the duplication SR-009 exists to remove, and the one planning-schema.sql's own CHECK comment names. `import` was never an observation mode: a historical import is carried by source_authority `historical-import`, and historical imports never enter active competition.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "native-event",
          "official-hook",
          "extension-api",
          "local-runtime",
          "acp",
          "otel",
          "proxy",
          "wrapper",
          "live-log"
        ]
      }
    },
    "capture_mechanism": {
      "enum": [
        "structured-event",
        "local-api",
        "sdk-callback",
        "gateway-metadata",
        "token-id-stream",
        "live-log-parser",
        "historical-import"
      ]
    },
    "required_permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "read-explicit-file",
          "connect-local-socket",
          "receive-sdk-callback",
          "bind-loopback",
          "inspect-own-process",
          "none"
        ]
      }
    },
    "observed_token_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "input",
          "output",
          "cache_read",
          "cache_write",
          "reasoning",
          "multimodal_input",
          "multimodal_output",
          "source_total"
        ]
      }
    },
    "source_authority": {
      "enum": [
        "provider-verifiable",
        "runtime-structured",
        "official-hook",
        "local-gateway",
        "exact-reconstruction",
        "historical-import"
      ]
    },
    "accounting_profile_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
        "maxLength": 128
      }
    },
    "certification": {
      "description": "The certification this manifest binds, as a state and a tuple. `state` was absent entirely: the block could name a bundle digest and a tuple and say nothing about whether that certification was active when it was read, while ACCOUNTING_AND_TIME_CONTRACT.md holds the effective ceiling at private-analytics for every state other than active. A manifest that cannot express the state cannot express that rule.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "bundle_sha256",
        "suite_version",
        "source_version",
        "platform_profile_id",
        "mode"
      ],
      "properties": {
        "state": {
          "description": "`uncertified` plus the eight states of the `source-certification` machine. The same nine values source-receipt-v1.schema.json and producer-accounting-binding-v1.schema.json carry, and the eight the state-machine registry and source_certifications.state declare. `uncertified` is not a machine state because a manifest bound to no certification has no aggregate.",
          "enum": [
            "uncertified",
            "candidate",
            "testing",
            "active",
            "degraded",
            "suspended",
            "expired",
            "superseded",
            "retired"
          ]
        },
        "bundle_sha256": {
          "description": "Null exactly while uncertified, which is the case evidence-bundle-v1.cddl already names and which normalized-event.schema.json, producer-accounting-binding-v1.schema.json, appraisal-result-v1.schema.json and openapi-v1.yaml already admit. Requiring a digest here meant no adapter manifest could validate without inventing one, and the committed example duly carried sixty-four `f` characters - the identical placeholder PF-016 deleted from normalized-event.valid.json.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "suite_version": {
          "type": "string",
          "maxLength": 40
        },
        "source_version": {
          "type": "string",
          "maxLength": 80
        },
        "platform_profile_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "mode": {
          "description": "One of the nine observation modes, the same set `modes` admits. This carried a bare slug pattern and no enum, so a certified tuple could name a mode observer-equivalence-v1.json assigns no precedence rank and the survivor rule would have had nothing to order it by.",
          "enum": [
            "native-event",
            "official-hook",
            "extension-api",
            "local-runtime",
            "acp",
            "otel",
            "proxy",
            "wrapper",
            "live-log"
          ]
        }
      },
      "allOf": [
        {
          "description": "A null digest and `uncertified` are the same fact and may not be stated apart. Admitting the null without binding it to the state would convert a representation gap into a permission: a manifest that forgot the digest would be indistinguishable from one that declared itself uncertified.",
          "if": {
            "properties": {
              "state": {
                "const": "uncertified"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "bundle_sha256": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "bundle_sha256": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "capability_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_public_profile",
        "requires_official_build",
        "requires_live_observation",
        "reason_codes"
      ],
      "properties": {
        "max_public_profile": {
          "enum": [
            "private-analytics",
            "standard-competitive",
            "hardened-source-bound"
          ]
        },
        "requires_official_build": {
          "type": "boolean"
        },
        "requires_live_observation": {
          "type": "boolean"
        },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
            "maxLength": 128
          }
        }
      }
    },
    "duplicate_domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
        "maxLength": 128
      }
    },
    "lifecycle": {
      "enum": [
        "experimental",
        "certified",
        "degraded",
        "suspended",
        "retired",
        "unsupported"
      ]
    },
    "emergency_disable": {
      "type": "boolean"
    },
    "sunset_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
