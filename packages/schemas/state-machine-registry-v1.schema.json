{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibemaxxing.dev/schemas/state-machine-registry-v1.json",
  "title": "Authoritative State Machine Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "machines"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "registry_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 160
    },
    "machines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "machine_id",
          "semantic_owner",
          "persistence_owner",
          "aggregate_key",
          "initial_state",
          "states",
          "terminal_states",
          "transitions",
          "privacy_boundary"
        ],
        "properties": {
          "machine_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
            "maxLength": 160
          },
          "semantic_owner": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
            "maxLength": 160
          },
          "persistence_owner": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
              "maxLength": 160
            }
          },
          "aggregate_key": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
            "maxLength": 160
          },
          "initial_state": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
            "maxLength": 160
          },
          "states": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
              "maxLength": 160
            }
          },
          "terminal_states": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
              "maxLength": 160
            }
          },
          "transitions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "transition_id",
                "from",
                "action",
                "to",
                "actor",
                "authentication",
                "recent_auth",
                "idempotency",
                "audit_event",
                "reversal",
                "transaction_boundary"
              ],
              "properties": {
                "transition_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
                  "maxLength": 160
                },
                "from": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
                    "maxLength": 160
                  }
                },
                "action": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
                  "maxLength": 160
                },
                "to": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
                  "maxLength": 160
                },
                "actor": {
                  "enum": [
                    "user",
                    "native-device",
                    "server-verifier",
                    "worker",
                    "moderator",
                    "release-authority",
                    "system"
                  ]
                },
                "authentication": {
                  "enum": [
                    "none",
                    "web-session",
                    "native-session",
                    "device-signature",
                    "moderator-session",
                    "threshold-signature",
                    "workload-identity"
                  ]
                },
                "recent_auth": {
                  "type": "boolean"
                },
                "idempotency": {
                  "enum": [
                    "not-applicable",
                    "principal-route-key",
                    "aggregate-action-key",
                    "exact-request-replay"
                  ]
                },
                "audit_event": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
                  "maxLength": 160
                },
                "reversal": {
                  "enum": [
                    "none",
                    "inverse-event",
                    "explicit-transition",
                    "projection-rebuild"
                  ]
                },
                "transaction_boundary": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
                  "maxLength": 160
                }
              }
            }
          },
          "privacy_boundary": {
            "enum": [
              "public-safe",
              "account-private",
              "integrity-private",
              "local-only",
              "release-public"
            ]
          }
        }
      }
    }
  }
}
