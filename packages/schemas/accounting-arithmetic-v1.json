    "normalizer_assigned": [
      {
        "normalized": "aborted-known",
        "reason": "No observation reports this. It is reached only when the profile's cancellation_policy is count-reported-consumption and the source reported a consumption figure alongside the abort, so it is the normalizer's conclusion from an aborted-unknown observation plus a policy, never a value a source can hand over."
      }
    ]
