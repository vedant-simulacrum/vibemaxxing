{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibemaxxing.dev/schemas/accounting-profile-v1.json",
  "title": "AccountingProfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "semantic_version",
    "content_sha256",
    "provider_or_runtime_id",
    "api_mode",
    "source_version_range",
    "model_or_tokenizer_id",
    "platforms",
    "effective_interval",
    "source_fields",
    "containment_edges",
    "component_map",
    "canonical_outputs",
    "source_total_authority",
    "cache_semantics",
    "reasoning_semantics",
    "modality_semantics",
    "retry_policy",
    "cancellation_policy",
    "nested_execution_policy",
    "reconstruction",
    "evidence_ceiling",
    "contradiction_policy"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "semantic_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provider_or_runtime_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "api_mode": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "source_version_range": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "model_or_tokenizer_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "macos",
          "windows",
          "linux",
          "wsl",
          "container",
          "ci",
          "remote"
        ]
      }
    },
    "effective_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "starts_at"
      ],
      "properties": {
        "starts_at": {
          "type": "string",
          "format": "date-time"
        },
        "ends_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "source_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field_id",
          "unit",
          "authority"
        ],
        "properties": {
          "field_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
            "maxLength": 128
          },
          "unit": {
            "enum": [
              "tokens",
              "token-equivalents",
              "items"
            ]
          },
          "authority": {
            "description": "Who is being trusted for this count, and the input to packages/schemas/accounting-arithmetic-v1.json#reconciliation.authority_order. The fourth value was spelled `reconstructed` here and `exact-reconstruction` in the nine other artifacts that carry the same vocabulary, including packages/schemas/normalized-event.schema.json#count_authority and packages/schemas/source-receipt-v1.schema.json#count_authority. The two spellings never overlap, so scripts/repository/validate_planning_artifacts.py's computed comparison of a bound profile's authorities against the event's count_authority reported a contradiction for every reconstruction profile whether or not one existed; it did not fire only because the one binding it runs over happens to bind a provider-reported profile.",
            "enum": [
              "provider-reported",
              "runtime-reported",
              "source-reported",
              "exact-reconstruction"
            ]
          }
        }
      }
    },
    "containment_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "container",
          "member"
        ],
        "properties": {
          "container": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
            "maxLength": 128
          },
          "member": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
            "maxLength": 128
          }
        }
      }
    },
    "component_map": {
      "description": "Which canonical component each declared source field resolves to. Without this the arithmetic in packages/schemas/accounting-arithmetic-v1.json has no way to place a source field, and two implementations can produce different totals from the same profile while both look conformant. Every entry in source_fields appears exactly once, and every canonical component named here appears in canonical_outputs.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_field",
          "canonical_component"
        ],
        "properties": {
          "source_field": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
            "maxLength": 128
          },
          "canonical_component": {
            "enum": [
              "input_uncached",
              "output_visible",
              "cache_read",
              "cache_write",
              "reasoning",
              "multimodal_input",
              "multimodal_output"
            ]
          }
        }
      }
    },
    "canonical_outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "input_uncached",
          "output_visible",
          "cache_read",
          "cache_write",
          "reasoning",
          "multimodal_input",
          "multimodal_output"
        ]
      }
    },
    "source_total_authority": {
      "enum": [
        "authoritative-exclusive",
        "authoritative-containing",
        "diagnostic-only",
        "absent"
      ]
    },
    "cache_semantics": {
      "enum": [
        "separate-read-write",
        "read-contained-in-input",
        "write-contained-in-input",
        "unavailable"
      ]
    },
    "reasoning_semantics": {
      "enum": [
        "separate-from-output",
        "contained-in-output",
        "unavailable"
      ]
    },
    "modality_semantics": {
      "enum": [
        "token-equivalent-separate",
        "contained-in-input-output",
        "unavailable"
      ]
    },
    "retry_policy": {
      "enum": [
        "each-model-execution",
        "caller-visible-only",
        "provider-total-authoritative"
      ]
    },
    "cancellation_policy": {
      "enum": [
        "count-reported-consumption",
        "count-terminal-total",
        "quarantine-unknown"
      ]
    },
    "nested_execution_policy": {
      "enum": [
        "children-exclusive",
        "parent-total-contains-children",
        "independent-with-dedup-domain"
      ]
    },
    "reconstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "enum": [
            "none",
            "exact-tokenizer",
            "runtime-token-ids"
          ]
        },
        "artifact_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "evidence_ceiling": {
      "enum": [
        "private-analytics",
        "standard-competitive",
        "hardened-source-bound"
      ]
    },
    "contradiction_policy": {
      "description": "What happens when two readings of one operation disagree and neither outranks the other. This is the recorded deterministic outcome packages/schemas/accounting-arithmetic-v1.json#reconciliation.equal_authority_contradiction defers to: the arithmetic fixes that the disagreement is detected and that it is never resolved by picking one, and the profile fixes which of the three dispositions the operation takes. Picking a survivor between two equally authoritative contradicting sources would make the total depend on which arrived first, which is the array-order dependence conformance/accounting/reconciliation-vectors-v1.json exists to refuse.",
      "enum": [
        "reject",
        "quarantine",
        "private-analytics"
      ]
    }
  }
}
