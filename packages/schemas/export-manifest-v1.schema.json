{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vibemaxxing.dev/export-manifest-v1.schema.json",
  "title": "Account export manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "export_id",
    "account_id",
    "scope",
    "requested_at",
    "generated_at",
    "expires_at",
    "archive_digest",
    "files",
    "deletion_state_at_generation"
  ],
  "properties": {
    "export_id": {
      "type": "string",
      "format": "uuid"
    },
    "account_id": {
      "type": "string",
      "format": "uuid"
    },
    "scope": {
      "enum": [
        "account",
        "claims",
        "social",
        "all"
      ]
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "archive_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "deletion_state_at_generation": {
      "enum": [
        "none",
        "cooling_off",
        "executing",
        "completed"
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "logical_name",
          "media_type",
          "size_bytes",
          "digest",
          "record_count"
        ],
        "properties": {
          "logical_name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._/-]{0,127}$"
          },
          "media_type": {
            "enum": [
              "application/jsonl",
              "application/json",
              "application/cbor"
            ]
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1073741824
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "record_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
