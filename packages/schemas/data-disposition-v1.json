    {"table": "local_deletion_commands", "classification": "personal", "data_domain": "requests-exports-deletion", "retention": {"policy_key": "deletion_job_proof_retention_days"}, "erasure_action": "retain-unlinked", "backup_set": "in-backup-set", "enforcement_owner": "retention-sweeper", "expiry_enforcement": "erasure-worker"},
