    {"table": "friend_requests", "classification": "personal", "data_domain": "social-presence-notifications", "retention": {"policy_key": "friend_request_expiry_days"}, "erasure_action": "delete", "backup_set": "in-backup-set", "enforcement_owner": "retention-sweeper"},
