    {"table": "appeal_decisions", "classification": "non-personal", "retention": {"policy_key": "appeal_record_retention_days"}, "erasure_action": "retain-unlinked", "backup_set": "in-backup-set", "enforcement_owner": "retention-sweeper"},

    {"table": "exports", "classification": "personal", "data_domain": "requests-exports-deletion", "retention": {"policy_key": "export_bundle_retention_days"}, "erasure_action": "delete", "backup_set": "in-backup-set", "enforcement_owner": "retention-sweeper", "expiry_enforcement": "retention-sweeper"},
