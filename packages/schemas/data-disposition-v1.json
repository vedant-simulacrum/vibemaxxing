    {"table": "score_contributions", "classification": "pseudonymous", "data_domain": "usage-claims-scores", "retention": {"rule": "indefinite-non-personal"}, "attribution_retention": {"rule": "ranked-identity-lifetime"}, "erasure_action": "key-destroy-retain", "backup_set": "in-backup-set", "enforcement_owner": "erasure-worker", "note": "claim_id clears on delete of the claim, so the arithmetic stays auditable and the claim link does not."},
