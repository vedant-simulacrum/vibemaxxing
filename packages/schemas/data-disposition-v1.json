    {"table": "idempotency_records", "classification": "personal", "data_domain": "requests-exports-deletion", "retention": {"policy_key": "idempotency_record_retention_days"}, "erasure_action": "delete", "backup_set": "in-backup-set", "enforcement_owner": "retention-sweeper", "expiry_enforcement": "rejected-at-read", "note": "Two dates and two sweeps. expires_at ends the replay window at D-225's 168 hours, where the response status, body and digest are discarded and the row moves to expired; idempotency_record_retention_days governs retain_until, which ends the row itself. The row has to outlive the response it can no longer replay, because deleting it at expires_at makes the key fresh and turns the next request carrying it into a second mutation rather than a 410."},
    {"table": "outbox_events", "classification": "pseudonymous", "retention": {"policy_key": "operational_telemetry_retention_days"}, "attribution_retention": {"rule": "no-retention"}, "erasure_action": "retain-pseudonymous", "backup_set": "in-backup-set", "enforcement_owner": "retention-sweeper", "note": "Not partitioned: unique (aggregate_id, aggregate_revision) is global and a partition key cannot join it without weakening exactly-once processing."},
