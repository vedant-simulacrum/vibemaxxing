    {"table": "period_scores", "classification": "personal", "data_domain": "usage-claims-scores", "retention": {"rule": "ranked-identity-lifetime"}, "erasure_action": "delete", "backup_set": "in-backup-set", "enforcement_owner": "erasure-worker", "note": "Live projection keyed on the account. The retained artifact is ranking_entries, keyed on the erasure-domain pseudonym."},
    {"table": "ranking_definitions", "classification": "non-personal", "retention": {"rule": "indefinite-non-personal"}, "erasure_action": "not-applicable", "backup_set": "in-backup-set", "enforcement_owner": "none-required", "note": "The stable half of a ranking view. It names a metric, a period, filters and digests, and no participant."},
