    {"table": "deletion_effects", "classification": "non-personal", "retention": {"policy_key": "deletion_job_proof_retention_days"}, "erasure_action": "retain-unlinked", "backup_set": "in-backup-set", "enforcement_owner": "retention-sweeper"},
