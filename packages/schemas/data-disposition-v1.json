    {"table": "organizations", "classification": "non-personal", "retention": {"rule": "indefinite-non-personal"}, "erasure_action": "retain-unlinked", "backup_set": "in-backup-set", "enforcement_owner": "erasure-worker", "note": "An erased owner leaves the organization; ownership transfer is a separate audited operation under D-071."},
    {"table": "communities", "classification": "non-personal", "retention": {"rule": "indefinite-non-personal"}, "erasure_action": "retain-unlinked", "backup_set": "in-backup-set", "enforcement_owner": "erasure-worker"},
