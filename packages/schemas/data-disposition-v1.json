    {"table": "ranking_entries", "classification": "pseudonymous", "data_domain": "usage-claims-scores", "retention": {"rule": "indefinite-non-personal"}, "attribution_retention": {"rule": "ranked-identity-lifetime"}, "erasure_action": "key-destroy-retain", "backup_set": "in-backup-set", "enforcement_owner": "erasure-worker"},
