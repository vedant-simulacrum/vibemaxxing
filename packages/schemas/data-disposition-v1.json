    {"table": "accounts", "classification": "personal", "data_domain": "account-identity", "retention": {"rule": "account-lifetime"}, "erasure_action": "delete", "backup_set": "in-backup-set", "enforcement_owner": "erasure-worker"},
    {"table": "account_handles", "classification": "personal", "data_domain": "account-identity", "retention": {"rule": "account-lifetime"}, "erasure_action": "delete", "backup_set": "in-backup-set", "enforcement_owner": "erasure-worker", "note": "A superseded handle redirect is kept for old_handle_redirect_days and is a separate row from the live assignment."},
