    {"table": "platform_install_operations", "classification": "non-personal", "retention": {"rule": "indefinite-non-personal"}, "erasure_action": "not-applicable", "backup_set": "in-backup-set", "enforcement_owner": "none-required"},
    {"table": "compatibility_edges", "classification": "non-personal", "retention": {"rule": "indefinite-non-personal"}, "erasure_action": "not-applicable", "backup_set": "in-backup-set", "enforcement_owner": "none-required", "note": "A retired edge is retained, because deciding whether an old build may still connect requires knowing what the range was when it shipped."},
    {"table": "storage_migrations", "classification": "non-personal", "retention": {"rule": "indefinite-non-personal"}, "erasure_action": "not-applicable", "backup_set": "in-backup-set", "enforcement_owner": "none-required", "note": "The rollback class of every applied step is retained for the life of the database, because a restore from any point inside the backup window has to know which steps were forward-only."},
    {"table": "tuf_roots", "classification": "non-personal", "retention": {"rule": "indefinite-non-personal"}, "erasure_action": "not-applicable", "backup_set": "in-backup-set", "enforcement_owner": "operator", "expiry_enforcement": "rejected-at-read"},
    {"table": "tuf_metadata", "classification": "non-personal", "retention": {"rule": "until-superseded"}, "erasure_action": "not-applicable", "backup_set": "in-backup-set", "enforcement_owner": "operator", "expiry_enforcement": "rejected-at-read", "note": "expires_at is the client's trust window rather than a retention window. Nothing sweeps it: expired metadata is refused at the moment it is read, which is the freeze-attack control and is why the actor is the reader and not a worker."},
    {"table": "release_sets", "classification": "non-personal", "retention": {"rule": "indefinite-non-personal"}, "erasure_action": "not-applicable", "backup_set": "in-backup-set", "enforcement_owner": "none-required"},
