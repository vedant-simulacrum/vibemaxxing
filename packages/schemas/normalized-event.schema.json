{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibemaxxing.dev/schemas/normalized-accounting-event-v1.json",
  "title": "NormalizedAccountingEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "session_id",
    "adapter",
    "certification",
    "source_id",
    "provider_id",
    "model_id",
    "accounting_profile",
    "monotonic_interval",
    "wall_time_observation",
    "canonical_tokens",
    "source_observed_categories",
    "count_authority",
    "reconstruction_method",
    "outcome",
    "retry",
    "duplicate_domain",
    "local_fingerprint",
    "rule_result",
    "privacy_scan",
    "network_eligible"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "parent_event_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "artifact_sha256",
        "manifest_sha256"
      ],
      "properties": {
        "adapter_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_sha256",
        "platform_profile_id",
        "capture_mode"
      ],
      "properties": {
        "bundle_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "platform_profile_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "capture_mode": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 128
        }
      }
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "provider_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "model_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "accounting_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "content_sha256"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "monotonic_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "generation",
        "start_ns",
        "end_ns"
      ],
      "properties": {
        "domain_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "generation": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "start_ns": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "end_ns": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      }
    },
    "wall_time_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "starts_at",
        "ends_at",
        "uncertainty_ms"
      ],
      "properties": {
        "starts_at": {
          "type": "string",
          "format": "date-time"
        },
        "ends_at": {
          "type": "string",
          "format": "date-time"
        },
        "uncertainty_ms": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      }
    },
    "canonical_tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_uncached",
        "output_visible",
        "cache_read",
        "cache_write",
        "reasoning",
        "multimodal_input",
        "multimodal_output"
      ],
      "properties": {
        "input_uncached": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "output_visible": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "cache_read": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "cache_write": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "reasoning": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "multimodal_input": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "multimodal_output": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      }
    },
    "source_observed_categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category_id",
          "count",
          "containment"
        ],
        "properties": {
          "category_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
            "maxLength": 128
          },
          "count": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,19})$"
          },
          "containment": {
            "enum": [
              "exclusive",
              "contains-other-categories",
              "contained-by-other-category",
              "diagnostic-total"
            ]
          }
        }
      }
    },
    "count_authority": {
      "enum": [
        "provider-reported",
        "runtime-reported",
        "source-reported",
        "exact-reconstruction"
      ]
    },
    "reconstruction_method": {
      "enum": [
        "none",
        "exact-tokenizer",
        "runtime-token-ids"
      ]
    },
    "outcome": {
      "enum": [
        "success",
        "failed-after-consumption",
        "cancelled-after-consumption",
        "aborted-known",
        "quarantined-unknown"
      ]
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "ordinal",
        "distinct_execution"
      ],
      "properties": {
        "scope": {
          "enum": [
            "none",
            "caller",
            "runtime",
            "provider"
          ]
        },
        "ordinal": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "distinct_execution": {
          "type": "boolean"
        }
      }
    },
    "duplicate_domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "scope"
      ],
      "properties": {
        "domain_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "scope": {
          "enum": [
            "account",
            "device-lineage",
            "source-runtime"
          ]
        }
      }
    },
    "local_fingerprint": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "rule_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "disposition",
        "reason_codes"
      ],
      "properties": {
        "bundle_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "disposition": {
          "enum": [
            "accept-local",
            "quarantine-local",
            "private-analytics"
          ]
        },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
            "maxLength": 128
          }
        }
      }
    },
    "privacy_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "result"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "result": {
          "enum": [
            "pass",
            "reject"
          ]
        }
      }
    },
    "local_detector_commitment": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "network_eligible": {
      "const": false
    }
  }
}
