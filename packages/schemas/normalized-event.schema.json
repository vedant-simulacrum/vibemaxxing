{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibemaxxing.dev/schemas/normalized-accounting-event-v1.json",
  "title": "NormalizedAccountingEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "session_id",
    "adapter",
    "certification",
    "source_id",
    "provider_id",
    "model_id",
    "accounting_profile",
    "monotonic_interval",
    "wall_time_observation",
    "operation",
    "observer",
    "reading",
    "canonical_tokens",
    "source_observed_categories",
    "count_authority",
    "reconstruction_method",
    "outcome",
    "retry",
    "duplicate_domain",
    "local_fingerprint",
    "rule_result",
    "privacy_scan",
    "network_eligible"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "parent_event_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "artifact_sha256",
        "manifest_sha256"
      ],
      "properties": {
        "adapter_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "certification": {
      "description": "Which certified tuple this capture was taken under, or the statement that there is none. bundle_sha256 was a required 64-hex string with no null admitted, and every producer binding in this repository carries null, so no NormalizedAccountingEvent could be constructed from any OTLP capture this repository can actually take and the only fixture that filled the field used sixty-four f characters. Four other artifacts had already made the same field nullable for the same reason - evidence-bundle-v1.cddl calls it 'nil while uncertified', and producer-accounting-binding-v1.schema.json, appraisal-result-v1.schema.json and openapi-v1.yaml all admit null - so this schema was the one out of step. Admitting null is not a certification: it is the honest representation of a capture taken under no certified tuple, and the allOf below pins such an event to private-analytics so that the representation cannot be mistaken for a permission.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_sha256",
        "platform_profile_id",
        "capture_mode"
      ],
      "properties": {
        "bundle_sha256": {
          "description": "The digest of the certification result bundle binding this exact tuple, or null when no certification binds it. Null is required rather than optional, so an uncertified capture is a statement the producer had to make and never an omission a reader has to interpret.",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "platform_profile_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "capture_mode": {
          "description": "The observation mode this capture was taken in, and with observer.collector_instance_id the exclusivity channel identity packages/schemas/observer-equivalence-v1.json names. It was an unconstrained slug, so an event could name a mode no precedence rank exists for and the survivor rule would have nothing to order it by; the nine values are exactly that record's observation_modes and exactly the vocabularies packages/schemas/source-observation.schema.json#execution_mode and packages/schemas/source-receipt-v1.schema.json use.",
          "enum": [
            "native-event",
            "extension-api",
            "official-hook",
            "otel",
            "acp",
            "proxy",
            "wrapper",
            "live-log",
            "local-runtime"
          ]
        }
      }
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "provider_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "model_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "accounting_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "content_sha256"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "monotonic_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "generation",
        "start_ns",
        "end_ns"
      ],
      "properties": {
        "domain_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "generation": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "start_ns": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "end_ns": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      }
    },
    "wall_time_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "starts_at",
        "ends_at",
        "uncertainty_ms"
      ],
      "properties": {
        "starts_at": {
          "type": "string",
          "format": "date-time"
        },
        "ends_at": {
          "type": "string",
          "format": "date-time"
        },
        "uncertainty_ms": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      }
    },
    "operation": {
      "description": "Which execution at the source this event accounts for. `event_id` is minted by the collector and `parent_event_id` links two of this collector's own records; neither survives being observed by a second collector, so neither could ever say that two events are about one execution. The source's own name for the execution is what can, and it is carried here with the discriminator that says how it was obtained. This is also the grouping key packages/schemas/accounting-arithmetic-v1.json#reconciliation uses: reconciliation is per operation, and an event with no operation identity cannot be reconciled with anything.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_source",
        "operation_ref",
        "parent_operation_ref"
      ],
      "properties": {
        "identity_source": {
          "enum": [
            "source-assigned",
            "source-cursor-derived",
            "absent"
          ]
        },
        "operation_ref": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,128}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "parent_operation_ref": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,128}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "observer": {
      "description": "Which collector instance produced this event. With certification.capture_mode it is the exclusivity channel identity packages/schemas/observer-equivalence-v1.json#exclusivity.channel_identity names, and the tied-channel rule - two instances in one mode over one source runtime deduplicate if their commitment sets are identical and quarantine if they are not - has no input without it. It is forbidden in the equivalence commitment preimage, and forbidden there for the same reason it is required here.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collector_instance_id",
        "adapter_instance_id"
      ],
      "properties": {
        "collector_instance_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        },
        "adapter_instance_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        }
      }
    },
    "reading": {
      "description": "Whether canonical_tokens came from a running total or from an increment, and how a restart of that total was detected. packages/schemas/accounting-profile-otel-v1.json records that the OTLP counter this repository can actually capture is cumulative and that monotonic_interval.generation is the reset counter; none of that reached the event, so an event carrying a cumulative reading and one carrying an already-differenced increment were the same bytes and adding the first to its predecessor double counts every token before it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accumulation",
        "reset_detection",
        "series_generation"
      ],
      "properties": {
        "accumulation": {
          "enum": [
            "cumulative",
            "delta"
          ]
        },
        "reset_detection": {
          "enum": [
            "value-decrease-or-start-time-change",
            "start-time-change-only",
            "not-applicable"
          ]
        },
        "series_generation": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      }
    },
    "canonical_tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_uncached",
        "output_visible",
        "cache_read",
        "cache_write",
        "reasoning",
        "multimodal_input",
        "multimodal_output"
      ],
      "properties": {
        "input_uncached": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "output_visible": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "cache_read": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "cache_write": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "reasoning": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "multimodal_input": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "multimodal_output": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      }
    },
    "source_observed_categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category_id",
          "count",
          "containment"
        ],
        "properties": {
          "category_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
            "maxLength": 128
          },
          "count": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,19})$"
          },
          "containment": {
            "enum": [
              "exclusive",
              "contains-other-categories",
              "contained-by-other-category",
              "diagnostic-total"
            ]
          }
        }
      }
    },
    "count_authority": {
      "enum": [
        "provider-reported",
        "runtime-reported",
        "source-reported",
        "exact-reconstruction"
      ]
    },
    "reconstruction_method": {
      "enum": [
        "none",
        "exact-tokenizer",
        "runtime-token-ids"
      ]
    },
    "outcome": {
      "description": "The normalized outcome. This vocabulary and packages/schemas/source-observation.schema.json#outcome had three values in common and two each that the other did not have: the observation could say `aborted-unknown` and `unknown`, and the event could say `aborted-known` and `quarantined-unknown`, with no mapping declared anywhere. `aborted-unknown` had to become `aborted-known` under that arrangement, which inverts the fact the source reported. `aborted-unknown` is now carried through unchanged and packages/schemas/accounting-arithmetic-v1.json#outcome_normalization declares the whole map, total over the observation vocabulary and checked in both directions.",
      "enum": [
        "success",
        "failed-after-consumption",
        "cancelled-after-consumption",
        "aborted-known",
        "aborted-unknown",
        "quarantined-unknown"
      ]
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "ordinal",
        "generation",
        "distinct_execution"
      ],
      "properties": {
        "scope": {
          "enum": [
            "none",
            "caller",
            "runtime",
            "provider"
          ]
        },
        "ordinal": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "generation": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "distinct_execution": {
          "type": "boolean"
        }
      }
    },
    "duplicate_domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "scope"
      ],
      "properties": {
        "domain_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "scope": {
          "enum": [
            "account",
            "device-lineage",
            "source-runtime"
          ]
        }
      }
    },
    "local_fingerprint": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "rule_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "disposition",
        "reason_codes"
      ],
      "properties": {
        "bundle_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "disposition": {
          "enum": [
            "accept-local",
            "quarantine-local",
            "private-analytics"
          ]
        },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
            "maxLength": 128
          }
        }
      }
    },
    "privacy_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "result"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "result": {
          "enum": [
            "pass",
            "reject"
          ]
        }
      }
    },
    "local_detector_commitment": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "network_eligible": {
      "const": false
    }
  },
  "allOf": [
    {
      "title": "An uncertified capture is private analytics",
      "description": "AGENTS.md states it as a binding rule: generic ACP, OpenTelemetry, proxy, wrapper and unknown-version integrations remain private analytics until an exact tuple is certified. Making bundle_sha256 nullable without this clause would have turned a representation gap into a permission - every capture in this repository would become expressible and none of them would be marked as what it is. The disposition is pinned in the schema rather than left to the collector because a collector that forgets is indistinguishable from one that decided.",
      "if": {
        "type": "object",
        "required": [
          "certification"
        ],
        "properties": {
          "certification": {
            "type": "object",
            "required": [
              "bundle_sha256"
            ],
            "properties": {
              "bundle_sha256": {
                "type": "null"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "rule_result": {
            "properties": {
              "disposition": {
                "const": "private-analytics"
              }
            }
          }
        }
      }
    },
    {
      "title": "An absent operation identity is not a null that means anything else",
      "description": "The same clause packages/schemas/source-observation.schema.json carries, for the same reason: identity_source states how the identity was obtained and operation_ref carries it, so `absent` beside a populated ref is an identity the collector supplied rather than read, and `source-assigned` beside a null ref is a claim to have read one that was not there. The equivalence class the server assigns follows from this discriminator, and a client that can set the two independently is choosing its own class.",
      "if": {
        "type": "object",
        "required": [
          "operation"
        ],
        "properties": {
          "operation": {
            "type": "object",
            "required": [
              "identity_source"
            ],
            "properties": {
              "identity_source": {
                "const": "absent"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "operation": {
            "properties": {
              "operation_ref": {
                "type": "null"
              },
              "parent_operation_ref": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "operation": {
            "properties": {
              "operation_ref": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "title": "An operation with no source-derived identity is private analytics",
      "description": "packages/schemas/observer-equivalence-v1.json calls this the weak class and says it never competes: nothing distinguishes a duplicate from a distinct execution, so counting it competitively would let a second observer of one execution add the same tokens again. The disposition is pinned in the schema for the same reason the uncertified clause above is - a collector that omits it is indistinguishable from one that decided.",
      "if": {
        "type": "object",
        "required": [
          "operation"
        ],
        "properties": {
          "operation": {
            "type": "object",
            "required": [
              "identity_source"
            ],
            "properties": {
              "identity_source": {
                "const": "absent"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "rule_result": {
            "properties": {
              "disposition": {
                "const": "private-analytics"
              }
            }
          }
        }
      }
    },
    {
      "title": "A cumulative reading declares how a reset is detected",
      "description": "An event whose canonical_tokens are a running total has to be differenced before it is added to anything, and a counter that restarts reads smaller than the reading before it. `not-applicable` is the honest value only for a reading that already is an increment.",
      "if": {
        "type": "object",
        "required": [
          "reading"
        ],
        "properties": {
          "reading": {
            "type": "object",
            "required": [
              "accumulation"
            ],
            "properties": {
              "accumulation": {
                "const": "cumulative"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "reading": {
            "properties": {
              "reset_detection": {
                "enum": [
                  "value-decrease-or-start-time-change",
                  "start-time-change-only"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
