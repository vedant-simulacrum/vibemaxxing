{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibemaxxing.dev/schemas/normalized-event-v1.json",
  "title": "Normalized Agent Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "session_id", "adapter", "source", "provider", "model", "platform", "mode", "monotonic_start_ns", "monotonic_end_ns", "tokens", "count_quality", "source_authority", "outcome", "retry_ordinal", "privacy_scan", "dedup_fingerprint"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "format": "uuid"},
    "session_id": {"type": "string", "format": "uuid"},
    "parent_event_id": {"type": ["string", "null"], "format": "uuid"},
    "adapter": {"$ref": "#/$defs/versionedId"},
    "source": {"$ref": "#/$defs/versionedId"},
    "provider": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_id", "raw_alias"],
      "properties": {
        "canonical_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "raw_alias": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "platform": {"enum": ["macos", "windows", "linux", "wsl", "container", "ci", "remote"]},
    "mode": {"enum": ["native-event", "extension-api", "official-hook", "otel", "proxy", "wrapper", "live-log", "provider-receipt", "import"]},
    "monotonic_start_ns": {"type": "integer", "minimum": 0},
    "monotonic_end_ns": {"type": "integer", "minimum": 0},
    "wall_start": {"type": ["string", "null"], "format": "date-time"},
    "wall_end": {"type": ["string", "null"], "format": "date-time"},
    "tokens": {"$ref": "#/$defs/tokens"},
    "count_quality": {"enum": ["provider-reported", "source-reported", "reconstructed", "estimated"]},
    "source_authority": {"enum": ["provider-receipt", "native-source-event", "official-structured-hook", "protocol-proxy", "live-source-observation", "reconstruction", "historical-import"]},
    "outcome": {"enum": ["success", "failed", "aborted", "unknown"]},
    "retry_ordinal": {"type": "integer", "minimum": 0},
    "cache_metadata": {"type": "object"},
    "modality": {"type": "array", "uniqueItems": true, "items": {"enum": ["text", "image", "audio", "video"]}},
    "privacy_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "result"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "result": {"enum": ["pass", "reject"]}
      }
    },
    "dedup_fingerprint": {"type": "string", "pattern": "^[A-Za-z0-9_-]{32,128}$"}
  },
  "$defs": {
    "versionedId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "version": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "input": {"type": ["integer", "null"], "minimum": 0},
        "output": {"type": ["integer", "null"], "minimum": 0},
        "cache_read": {"type": ["integer", "null"], "minimum": 0},
        "cache_write": {"type": ["integer", "null"], "minimum": 0},
        "reasoning": {"type": ["integer", "null"], "minimum": 0},
        "multimodal_input": {"type": ["integer", "null"], "minimum": 0},
        "multimodal_output": {"type": ["integer", "null"], "minimum": 0},
        "source_total": {"type": ["integer", "null"], "minimum": 0},
        "source_total_includes_subcategories": {"type": ["boolean", "null"]}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"monotonic_start_ns": {"type": "integer"}, "monotonic_end_ns": {"type": "integer"}}}, "then": {}}
  ]
}
