{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vibemaxxing.dev/release-set-v1.schema.json",
  "title": "VibeMaxxing signed release set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_set_id",
    "version",
    "published_at",
    "mandatory_after",
    "tuf_root_version",
    "targets",
    "compatibility_registry_digest",
    "signing_threshold"
  ],
  "properties": {
    "release_set_id": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "mandatory_after": {
      "type": "string",
      "format": "date-time"
    },
    "tuf_root_version": {
      "type": "integer",
      "minimum": 1
    },
    "compatibility_registry_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signing_threshold": {
      "type": "integer",
      "minimum": 2,
      "maximum": 10
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform_profile_id",
          "artifact_kind",
          "artifact_digest",
          "size_bytes",
          "sbom_digest",
          "provenance_digest",
          "signature_bundle_digest"
        ],
        "properties": {
          "platform_profile_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "artifact_kind": {
            "enum": [
              "pkg",
              "dmg",
              "msix",
              "msi",
              "deb",
              "rpm",
              "apk",
              "tar-zst",
              "oci",
              "ci-bundle"
            ]
          },
          "artifact_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483648
          },
          "sbom_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "provenance_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "signature_bundle_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
