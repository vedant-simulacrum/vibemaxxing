{
  "name": "@vibemaxxing/ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:compare": "node scripts/compare-product-storyboards.mjs",
    "tokens:generate": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check",
    "test": "esbuild src/components.test.tsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=/tmp/vibemaxxing-ui.test.cjs && node --test /tmp/vibemaxxing-ui.test.cjs"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/components.tsx",
    "./components.css": "./src/components.css",
    "./leaderboard": "./src/concepts/leaderboard-first.tsx",
    "./leaderboard.css": "./src/concepts/leaderboard-first.css",
    "./product-screens": "./src/concepts/product-storyboards.tsx",
    "./product-screens.css": "./src/concepts/product-storyboards.css",
    "./competition-suite": "./src/concepts/competition-suite.tsx",
    "./competition-suite.css": "./src/concepts/competition-suite.css",
    "./tokens.css": "./src/tokens.css",
    "./tokens": "./src/tokens.ts"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.2",
    "@storybook/addon-docs": "^10.5.2",
    "@storybook/react-vite": "^10.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.1",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "storybook": "^10.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "tailwind-merge": "^3.6.0"
  }
}
