{
  "schema_version": 1,
  "profile_id": "authorization-invalidation-vectors-v1",
  "description": "One case per trigger declared in packages/schemas/projection-authorization-v1.json. Every trigger has a case, because a trigger nothing exercises is a rule nobody has ever reached, and every case records what it retains so that a corpus in which everything invalidates everything is refused.",
  "cases": [
    {
      "case_id": "AI-001",
      "trigger": "block-established",
      "note": "The case the finding is named for. A block reaches every live surface that renders the blocked party and reaches none of the three that do not: the universally-public global board has no viewer to evaluate it against, the viewer's own block list must keep showing the people they blocked, and an export has no second party. The cursor dies because it pinned a revision that has moved; the export download grant survives because the block changed nothing about the subject's own data.",
      "expected": {
        "changed_inputs": [
          "directional-block"
        ],
        "affected_surfaces": [
          "friend-list",
          "leaderboard-page",
          "notification-delivery",
          "notification-render",
          "presence-projection",
          "public-profile",
          "rival-list"
        ],
        "unaffected_surfaces": [
          "block-list",
          "export-package",
          "global-leaderboard-page"
        ],
        "invalidated_artifacts": [
          "ranking-cursor",
          "shared-response-cache"
        ],
        "retained_artifacts": [
          "export-download-grant",
          "sealed-generation-projection"
        ]
      }
    },
    {
      "case_id": "AI-002",
      "trigger": "block-removed",
      "note": "Unblocking is a change of the same size as blocking. Nothing was destroyed when the block was made, so nothing is restored — but the revision still moves, and a cursor issued while the block held is refused rather than silently widened to the entries it was suppressing.",
      "expected": {
        "changed_inputs": [
          "directional-block"
        ],
        "affected_surfaces": [
          "friend-list",
          "leaderboard-page",
          "notification-delivery",
          "notification-render",
          "presence-projection",
          "public-profile",
          "rival-list"
        ],
        "unaffected_surfaces": [
          "block-list",
          "export-package",
          "global-leaderboard-page"
        ],
        "invalidated_artifacts": [
          "ranking-cursor",
          "shared-response-cache"
        ],
        "retained_artifacts": [
          "export-download-grant",
          "sealed-generation-projection"
        ]
      }
    },
    {
      "case_id": "AI-003",
      "trigger": "board-membership-removed",
      "note": "A board removal reaches the two surfaces that read membership and no others. The removed member's board leaderboard cursor stops resolving; their sealed entries in that generation do not move, are not renumbered and are not rewritten, which is the immutable-history half of SR-015 stated as an outcome rather than as a sentence.",
      "expected": {
        "changed_inputs": [
          "board-membership"
        ],
        "affected_surfaces": [
          "leaderboard-page",
          "presence-projection"
        ],
        "unaffected_surfaces": [
          "block-list",
          "export-package",
          "friend-list",
          "global-leaderboard-page",
          "notification-delivery",
          "notification-render",
          "public-profile",
          "rival-list"
        ],
        "invalidated_artifacts": [
          "ranking-cursor",
          "shared-response-cache"
        ],
        "retained_artifacts": [
          "export-download-grant",
          "sealed-generation-projection"
        ]
      }
    },
    {
      "case_id": "AI-004",
      "trigger": "board-archived",
      "note": "Archiving is narrower than removal: the container state is subject-only, so it reaches the surfaces that read it without touching the pair-shaped membership decision.",
      "expected": {
        "changed_inputs": [
          "board-container-state"
        ],
        "affected_surfaces": [
