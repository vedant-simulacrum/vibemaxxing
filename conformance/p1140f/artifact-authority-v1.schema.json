{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibemaxxing.dev/schemas/artifact-authority-v1.schema.json",
  "title": "Planning artifact authority registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "authority_class", "evidence_ceiling", "normative_owner", "prohibited_uses"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "authority_class": {"enum": ["normative-planning", "candidate-planning", "exploratory-prototype", "historical-non-authoritative"]},
          "evidence_ceiling": {"enum": ["schema-valid", "structurally-consistent", "fixture-consistent", "cross-language-parity", "normative-conformance", "adversarial-tested", "platform-exercised", "production-evidence"]},
          "normative_owner": {"type": ["string", "null"]},
          "known_incompatibilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "prohibited_uses": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
