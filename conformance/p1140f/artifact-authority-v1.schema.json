{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibemaxxing.dev/schemas/artifact-authority-v1.schema.json",
  "title": "Planning artifact authority registry",
  "description": "The registry declares its own vocabulary: evidence_ceilings is the ordered ladder and authority_classes caps each class against it. Artifact rows therefore carry plain strings rather than an enum repeated here, because a schema holding a second copy of the vocabulary is how the registry and its checker drift apart. Membership is enforced by scripts/repository/validate_p1140f_authority.py, which reads the ladder from this document, and by scripts/ci/run_evals.py for eval suites.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "vocabulary_owner", "evidence_ceilings", "authority_classes", "artifacts"],
  "properties": {
    "schema_version": {"const": 2},
    "vocabulary_owner": {"const": "docs/planning/ARTIFACT_POLICY.md"},
    "evidence_ceilings": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "description": "Ordered weakest to strongest. The first entry must be the empty claim."
    },
    "authority_classes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["maximum_evidence_ceiling", "note"],
        "properties": {
          "maximum_evidence_ceiling": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "authority_class", "evidence_ceiling", "normative_owner", "prohibited_uses"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "authority_class": {"type": "string", "minLength": 1},
          "evidence_ceiling": {"type": "string", "minLength": 1},
          "normative_owner": {"type": ["string", "null"]},
          "known_incompatibilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "prohibited_uses": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
