{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibemaxxing.dev/schemas/gate-authorization-v1.schema.json",
  "title": "Repository phase and gate authorization record",
  "description": "Sole machine-readable owner of repository phase, gate state, and the per-severity open-finding non-regression ceilings. Validators derive gate state from this file; prose documents summarize it and may not independently redefine it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "phase", "recorded_at", "finding_registry", "open_p1_baseline", "registry_summary_documents", "open_p1_claim_patterns", "gates"],
  "$defs": {
    "open_baseline": {
      "description": "One non-regression ceiling for one severity. There is a named property per severity the finding registry can carry, each pinning its own severity constant, so a ceiling cannot be recorded under the wrong name and a regrade cannot move a finding outside every ceiling. Only open_p1_baseline is required, because a severity with no open findings needs no ceiling; validate_p1140f_authority.py fails when a severity that does have open findings has no ceiling here.",
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "count", "rule", "counted_states", "recorded_at", "reference"],
      "properties": {
        "severity": {"enum": ["P0", "P1", "P2"]},
        "count": {"type": "integer", "minimum": 0},
        "rule": {"const": "non-regression"},
        "counted_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["open", "repair-in-progress", "repaired-pending-review", "closed", "deferred", "superseded"]}
        },
        "recorded_at": {"type": "string", "format": "date"},
        "reference": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1}
      }
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "phase": {"enum": ["planning-contract-repair", "implementation"]},
    "phase_note": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date"},
    "finding_registry": {"type": "string", "minLength": 1},
    "open_p0_baseline": {
      "allOf": [{"$ref": "#/$defs/open_baseline"}, {"properties": {"severity": {"const": "P0"}}}]
    },
    "open_p1_baseline": {
      "allOf": [{"$ref": "#/$defs/open_baseline"}, {"properties": {"severity": {"const": "P1"}}}]
    },
    "open_p2_baseline": {
      "allOf": [{"$ref": "#/$defs/open_baseline"}, {"properties": {"severity": {"const": "P2"}}}]
    },
    "registry_summary_documents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "open_p1_claim_patterns": {
      "description": "Regular expressions, each with one capturing group, that locate an open-P1 count claim in a registry summary document. Every claim found must equal the live registry count. Patterns are data so that rephrasing prose never requires editing a validator.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "state", "authorization", "documents"],
        "properties": {
          "gate": {"type": "string", "pattern": "^P-[0-9]{4}[A-Z]?$"},
          "state": {
            "enum": [
              "complete-planning",
              "in-progress-planning",
              "blocked-planning",
              "blocked-implementation",
              "blocked-approval",
              "blocked-launch-evidence",
              "authorized-open"
            ]
          },
          "authorization": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": [
              "authorized_by",
              "authorized_at",
              "reference",
              "reference_kind",
              "open_p1_findings_at_authorization",
              "opened_with_open_findings",
              "findings_waived",
              "acknowledgement"
            ],
            "properties": {
              "authorized_by": {"type": "string", "minLength": 1},
              "authorized_at": {"type": "string", "format": "date"},
              "reference": {"type": "string", "minLength": 1},
              "reference_kind": {"enum": ["github-issue", "github-pull-request", "decision-record"]},
              "open_p1_findings_at_authorization": {"type": "integer", "minimum": 0},
              "findings_open_at_authorization": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^SR-[0-9]{3}$"}
              },
              "opened_with_open_findings": {"type": "boolean"},
              "findings_waived": {"const": false},
              "preconditions_met": {"type": "boolean"},
              "acknowledgement": {"type": "string", "minLength": 1},
              "stated_rationale": {"type": "string", "minLength": 1}
            }
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "requires", "forbids"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "requires": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "forbids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
              }
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"state": {"const": "authorized-open"}}, "required": ["state"]},
            "then": {"properties": {"authorization": {"type": "object"}}}
          }
        ]
      }
    }
  }
}
