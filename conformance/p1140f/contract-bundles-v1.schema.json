{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibemaxxing.dev/schemas/contract-bundles-v1.schema.json",
  "title": "Planning contract bundle registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundles"],
  "properties": {
    "schema_version": {"const": 1},
    "bundles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bundle_id", "concept", "state", "finding_ids", "normative_owner", "machine_owners", "lifecycle_owner", "persistence_owner", "authority_model", "transaction_boundary", "privacy_owner", "threat_mappings", "fixtures", "implementation_owner", "prohibited_authority"],
        "properties": {
          "bundle_id": {"type": "string", "pattern": "^CB-[0-9]{3}$"},
          "concept": {"type": "string", "minLength": 3},
          "state": {"enum": ["complete-planning", "blocked-semantic", "planned-missing", "post-launch"]},
          "finding_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SR-[0-9]{3}$"}},
          "normative_owner": {"type": "string", "minLength": 1},
          "machine_owners": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "lifecycle_owner": {"type": "string", "minLength": 1},
          "persistence_owner": {"type": "string", "minLength": 1},
          "authority_model": {"type": "string", "minLength": 1},
          "transaction_boundary": {"type": "string", "minLength": 1},
          "privacy_owner": {"type": "string", "minLength": 1},
          "threat_mappings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "fixtures": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "implementation_owner": {"type": "string", "minLength": 1},
          "prohibited_authority": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
