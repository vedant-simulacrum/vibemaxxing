    {
      "vector_id": "observer-derived-preimage-input-rejects",
      "note": "The defect itself, as a fixture. A commitment built over the collector's own instance identifier can never collide with another observer's, which is how a client decided for itself that its observation was not a duplicate. The rule forbids the input and the observation is rejected rather than counted.",
      "observations": [
        {
          "observation_id": "self-scoped-commitment",
          "mode": "otel",
          "equivalence_class": "source-cursor",
          "collector_instance": "alpha",
          "preimage_inputs": [
