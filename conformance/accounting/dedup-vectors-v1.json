            "source_id",
            "source_runtime_id",
            "runtime_generation",
            "collector_instance_id"
          ],
          "facts": {
            "device_lineage_id": "lineage-seven",
            "source_id": "claude-code",
            "source_runtime_id": "runtime-nine",
            "runtime_generation": "0",
            "collector_instance_id": "alpha"
          },
          "token_burn": "500"
        }
      ],
      "expected": {
