      "id": "challenge-without-expected-tuple",
      "cddl_rule": "challenge-v1",
      "cddl_hex": "a900010150018f6e508f4a7cc09f6c01020304050c02582022222222222222222222222222222222222222222222222222222222222222220350018f6e508f4a7cc09f6c01020304050d0458203333333333333333333333333333333333333333333333333333333333333333081b000001989146e800091b0000019891500fc00a1901000b1a00100000",
