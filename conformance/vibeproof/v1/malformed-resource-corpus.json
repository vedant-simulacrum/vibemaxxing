      "cddl_hex": "a40050018f6e508f4a7cc09f6c0102030405080100028003f6",
      "stage": "cddl-conformance",
      "expected": "reject",
      "reason_code": "claim-accepted-without-appraisal",
      "registry_reason_code": "BATCH_ATOMIC_REJECT",
      "note": "An accepted claim result whose appraisal reference is nil. VerifierAppraisal is created for every accepted claim in the same transaction that accepts it, so an acceptance with nothing to appeal against is not an acceptance."
    },
    {
      "id": "claim-refused-result-without-reason",
      "cddl_rule": "claim-refused-result-v1",
