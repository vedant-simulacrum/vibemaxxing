      "cddl_hex": "a700010150018f6e508f4a7cc09f6c010203040507020003582011111111111111111111111111111111111111111111111111111111111111110482a40050018f6e508f4a7cc09f6c010203040508010002800350018f6e508f4a7cc09f6c010203040509a40050018f6e508f4a7cc09f6c01020304050a010502810303f605800640",
