{
  "schema_version": 2,
  "protocol_major": 1,
  "reason_authority": "packages/schemas/reason-codes-v1.json",
  "note": "The sole negative-vector corpus for VibeProof v1. PF-054 originally planned a second file named negative-vectors.json beside this one; it is not created, because a rule name declared in a third vector file is exactly what PF-002's ownership check refuses, and because validate_conformance_manifests fails on any file in this directory no manifest case names.",
  "stages": [
    "canonical-decode",
    "cose-profile",
    "signature",
    "resource-limits",
    "transaction",
    "rotation",
    "cddl-conformance"
  ],
  "outcomes": [
    "reject",
    "reject-before-decode",
    "reject-before-allocation",
    "reject-before-signature",
    "reject-before-claim-loop",
    "conflict",
    "quarantine-lineage"
  ],
  "cddl_rules_pinned": [
    "atomic-batch-result-v1",
    "batch-context",
    "challenge-v1",
    "claim-accepted-result-v1",
    "claim-refused-result-v1",
    "claim-result-v1",
    "correction-record-v1",
    "cose-sign1-rotation-v1",
    "dual-authorized-rotation-v1",
    "gap-declaration",
    "key-rotation-transition-v1"
  ],
  "cddl_rules_unpinned": [
    {
      "rule": "verifier-appraisal-v1",
      "work_unit": "P-007",
      "reason": "A server appraisal is produced by the verifier, not submitted to it, so no decoder-boundary case exists to write. No encoded instance exists in either corpus."
    },
    {
      "rule": "cose-sign1-gap-v1",
      "work_unit": "P-007",
      "reason": "A COSE_Sign1 is a tagged item and the canonical profile decoder refuses every tag by design, so no case in this corpus can decode one; a cddl_hex case for it would be refused at the decoder and would exercise nothing. The two envelopes that exist in bytes are checked structurally by _check_cose_envelope against exact-byte-vectors.json, and a gap envelope joins them when a vector signs one."
    },
    {
      "rule": "protected-headers-gap-v1",
      "work_unit": "P-007",
      "reason": "The protected headers of a message no vector signs yet. They are reachable from no other rule, so they are named here rather than inferred; pinning them requires the gap vector that cose-sign1-gap-v1 is waiting on."
    }
  ],
