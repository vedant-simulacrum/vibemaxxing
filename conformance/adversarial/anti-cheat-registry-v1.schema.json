{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibemaxxing.dev/schemas/anti-cheat-registry-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "actions", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "registry_version": {"type": "string", "minLength": 1},
    "actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/action"}
    },
    "cases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "action": {"enum": ["accept", "accept_idempotently", "downgrade_standard", "exclude_claim", "quarantine_session", "quarantine_score", "require_stronger_evidence", "human_review", "revoke_device", "restrict_ranking", "restore_after_appeal", "suspend_adapter", "block_update", "halt_and_reconcile", "reject_dataset_version", "break_hardened_continuity"]},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "name", "expected_action", "reason_code", "controls", "owner", "fixture", "appeal", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^AC-A-[0-9]{3}$"},
        "class": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "expected_action": {"$ref": "#/$defs/action"},
        "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "controls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
        "owner": {"enum": ["protocol", "native", "adapter", "server", "identity", "ranking", "trust-safety", "operations", "privacy"]},
        "fixture": {"type": "string", "pattern": "^conformance/adversarial/fixtures/[a-z0-9-]+\\.json$"},
        "appeal": {"enum": ["not-applicable", "eligible", "human-review-required"]},
        "status": {"enum": ["planned", "implemented", "exercised", "hardened"]}
      }
    }
  }
}
